generator client {
    provider = "prisma-client-js"
    // output = "../src/generated/client"
}

datasource db {
    provider = "postgresql"
}

model User {
    id        String   @id @default(cuid())
    email     String   @unique
    firstName      String
    lastName       String
    password  String? 
    emailVerified Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
